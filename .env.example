# Database & Vector DB (Postgres 16 + pgvector)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/knowledge_assistant_db?schema=public"

# Redis (BullMQ Queue)
REDIS_URL="redis://localhost:6379"

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI Model Providers (Default: Google Gemini)
GEMINI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-proj-...
