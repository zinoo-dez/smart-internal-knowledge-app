# Database & Vector DB (Postgres 16 + pgvector)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/knowledge_assistant_db?schema=public"

# Redis (BullMQ Queue)
REDIS_URL="redis://localhost:6379"

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI Model Providers (Default: Google Gemini)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_HELPER_MODEL="gemini-2.5-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL="gpt-4o"
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Optional External Multilingual Cross-Encoder Rerankers (falls back cleanly to local cross-lingual reranker)
COHERE_API_KEY=
JINA_API_KEY=

# Production Ingestion Guardrail (set "true" ONLY for keyless portfolio demos in NODE_ENV=production)
ALLOW_SYNTHETIC_EMBEDDINGS="false"

# Observability & Evaluation
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT="smart-internal-knowledge-assistant"
FAITHFULNESS_JUDGE_SAMPLE_RATE="0.25"

# App Ports & URLs
NEXT_PUBLIC_API_URL="http://localhost:4000"
PORT=4000
