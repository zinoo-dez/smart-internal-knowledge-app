datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  ADMIN
  MEMBER
}

enum Department {
  ALL
  HR
  ENGINEERING
  OPERATIONS
  EXECUTIVE
}

enum DocumentSource {
  FILE_UPLOAD
  NOTION
  SLACK
  GOOGLE_DRIVE
  CONFLUENCE
}

enum IngestionStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

enum FeedbackType {
  THUMBS_UP
  THUMBS_DOWN
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketCategory {
  IT
  HR
  OPS
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum McpTransport {
  SSE
  STDIO
}

enum McpStatus {
  CONNECTED
  ERROR
  DISABLED
  DEGRADED
}

model Organization {
  id               String   @id @default(uuid())
  clerkOrgId       String   @unique
  name             String
  subscriptionTier String   @default("PRO")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users          User[]
  documents      Document[]
  documentChunks DocumentChunk[]
  conversations  Conversation[]
  queryLogs      QueryLog[]
  feedbacks      Feedback[]
  supportTickets SupportTicket[]
  auditLogs      AuditLog[]
  mcpServers     McpServer[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  clerkUserId    String       @unique
  organizationId String
  email          String
  name           String?
  role           UserRole     @default(MEMBER)
  department     Department   @default(ALL)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  queryLogs      QueryLog[]
  feedbacks      Feedback[]
  supportTickets SupportTicket[]
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@map("users")
}

model Document {
  id             String          @id @default(uuid())
  organizationId String
  title          String
  source         DocumentSource  @default(FILE_UPLOAD)
  department     Department      @default(ALL)
  sourceUrl      String?
  mimeType       String?
  status         IngestionStatus @default(PENDING)
  errorMessage   String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]

  @@index([organizationId, status])
  @@map("documents")
}

model DocumentChunk {
  id             String                      @id @default(uuid())
  documentId     String
  organizationId String
  chunkIndex     Int
  content        String
  department     Department                  @default(ALL)
  embedding      Unsupported("vector(768)")? // Google Gemini text-embedding-004 dimension
  tsv            Unsupported("tsvector")?    // Full-text search keyword tsvector
  metadata       Json?
  createdAt      DateTime                    @default(now())

  document       Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, department])
  @@index([documentId])
  @@map("document_chunks")
}

model QueryLog {
  id               String       @id @default(uuid())
  organizationId   String
  userId           String
  conversationId   String?
  query            String
  response         String
  modelProvider    String       @default("GEMINI")
  modelName        String       @default("gemini-1.5-flash")
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  totalTokens      Int          @default(0)
  latencyMs        Int          @default(0)
  faithfulnessScore Float?      @default(1.0)
  langsmithRunId   String?
  citations        Json?
  isUnresolved     Boolean      @default(false)
  gapCategory      String?
  assignedTo       String?
  resolvedAt       DateTime?
  resolutionNote   String?
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbacks        Feedback[]

  @@index([organizationId, createdAt])
  @@index([organizationId, isUnresolved])
  @@map("query_logs")
}

model Feedback {
  id             String       @id @default(uuid())
  queryLogId     String
  userId         String
  organizationId String
  type           FeedbackType
  comment        String?
  createdAt      DateTime     @default(now())

  queryLog       QueryLog     @relation(fields: [queryLogId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([queryLogId])
  @@map("feedbacks")
}

model SupportTicket {
  id             String         @id @default(uuid())
  organizationId String
  userId         String
  title          String
  description    String
  priority       TicketPriority @default(MEDIUM)
  category       TicketCategory @default(IT)
  status         TicketStatus   @default(OPEN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("support_tickets")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  action         String
  resource       String
  details        Json?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model Conversation {
  id             String              @id @default(uuid())
  organizationId String
  userId         String
  title          String              @default("New Conversation")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       ChatMessageRecord[]

  @@index([organizationId, userId])
  @@index([organizationId, userId, updatedAt])
  @@index([updatedAt])
  @@map("conversations")
}

model ChatMessageRecord {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // 'user' | 'assistant'
  content        String
  citations      Json?        // DocumentCitation[]
  queryLogId     String?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model McpServer {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String?
  transport      McpTransport  @default(SSE)
  endpointUrl    String?
  command        String?
  envSecrets     String?       // AES-256-GCM encrypted JSON string
  status         McpStatus     @default(CONNECTED)
  latencyMs      Int?          @default(0)
  lastPingAt     DateTime?
  errorMessage   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tools          McpTool[]

  @@index([organizationId])
  @@map("mcp_servers")
}

model McpTool {
  id              String        @id @default(uuid())
  serverId        String
  name            String
  description     String?
  inputSchema     Json
  isEnabled       Boolean       @default(true)
  requireApproval Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  server          McpServer     @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
  @@index([serverId])
  @@map("mcp_tools")
}
